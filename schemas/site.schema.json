{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/stephanus-supandi/bloon_gsv_survey/blob/master/schemas/site.schema.json",
  "title": "BLOON GSV Site",
  "description": "A physical location or spatial container, not a business or observation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "site_id",
    "country",
    "site_type",
    "geometry_status",
    "evidence_status"
  ],
  "properties": {
    "site_id": {
      "type": "string",
      "minLength": 1
    },
    "site_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "site_type": {
      "type": "string",
      "enum": [
        "STANDALONE",
        "PLAZA",
        "INDUSTRIAL_COMPLEX",
        "RESIDENTIAL_FRONTAGE",
        "INSTITUTIONAL_SITE",
        "MIXED_USE",
        "UNKNOWN"
      ]
    },
    "locality": {
      "type": [
        "string",
        "null"
      ]
    },
    "admin_area": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": "string",
      "minLength": 1
    },
    "address_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "latitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": [
        "number",
        "null"
      ],
      "minimum": -180,
      "maximum": 180
    },
    "geometry_status": {
      "type": "string",
      "enum": [
        "UNKNOWN",
        "APPROXIMATE",
        "CANDIDATE",
        "VERIFIED"
      ]
    },
    "evidence_status": {
      "type": "string",
      "enum": [
        "USER_REPORTED",
        "VISUALLY_REVIEWED",
        "INDEPENDENTLY_VERIFIED"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
